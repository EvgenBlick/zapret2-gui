{
  "name": "zapret2-manager",
  "version": "1.1.0",
  "description": "Premium Windows GUI for zapret2 anti-DPI with split tunneling",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --remote-debugging-port=9229",
    "dev": "electron . --remote-debugging-port=9229 --inspect",
    "screenshot": "node scripts/screenshot.js",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --dir",
    "lint": "eslint src/renderer/"
  },
  "build": {
    "appId": "com.zapret2.manager",
    "productName": "Zapret2 Manager",
    "copyright": "Based on bol-van/zapret2",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "signDlls": false
    },
    "portable": {
      "requestExecutionLevel": "admin"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "asar": true
  },
  "keywords": [
    "zapret2",
    "dpi",
    "split-tunneling",
    "windivert",
    "electron"
  ],
  "author": "Zapret2 Manager Contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  }
}
